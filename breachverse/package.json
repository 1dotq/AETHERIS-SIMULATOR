{
  "name": "breachverse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c yellow,cyan \"npm run dev -w @breachverse/game-server\" \"npm run dev -w @breachverse/web\"",
    "dev:server": "npm run dev -w @breachverse/game-server",
    "dev:web": "npm run dev -w @breachverse/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "build": "npm run typecheck && npm run build -w @breachverse/web",
    "check": "npm run lint && npm run typecheck && npm test && npm run build -w @breachverse/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
